# Elasticsearch API Tests for Visual Studio Code REST Client
# Install the REST Client extension to use this file

@baseUrl = http://localhost:8010/api

### Health Check
GET {{baseUrl}}/

### Elasticsearch Health Check
GET {{baseUrl}}/elasticsearch/health

### Create Indices
POST {{baseUrl}}/elasticsearch/indices/create
Content-Type: application/json

### ========================================
### PRODUCTION ORDERS
### ========================================

### Create Production Order
POST {{baseUrl}}/elasticsearch/production-orders
Content-Type: application/json

{
    "data": {
        "id": 90,
        "identity_number": "2251030001",
        "product_code": "7200-TJ104",
        "customer_id": 65,
        "product_work_center_id": 6,
        "shift_id": 2,
        "planning_date": "2025-10-30",
        "qty": 100,
        "overtime": 0,
        "plant_id": 2,
        "standard_packing_qty": 5,
        "status_id": 4,
        "created_by": 9,
        "modified_by": 9,
        "created_at": "2025-10-30T04:10:19.000000Z",
        "updated_at": "2025-10-30T08:48:43.000000Z",
        "actual_qty": {
            "uom": "PCE",
            "station": {
                "start": "WH_WASUREMBO",
                "finish": "WH_VISUAL_INSPECTION_2"
            },
            "WH_WASUREMBO": 5,
            "WH_JIG_REPORT": 1,
            "WH_VISUAL_INSPECTION_1": 0,
            "WH_CHECKER": 0,
            "WH_VISUAL_INSPECTION_2": 0
        },
        "traceabilities": [
            {
                "id": 835,
                "model_type": "App\\Models\\Nameplate",
                "model_id": 602,
                "station_id": 12,
                "user_id": 9,
                "content": {
                    "tool_id": 3
                },
                "status_id": 1,
                "created_at": "2025-10-30T08:49:41.000000Z",
                "updated_at": "2025-10-30T08:49:41.000000Z"
            }
        ],
        "customer": {
            "id": 65,
            "external_code": "119920",
            "customer": "AJI",
            "description": "PT. ASTRA JUOKU INDONESIA"
        },
        "plant": {
            "id": 2,
            "plant": "1502",
            "description": "PLANT 2 CIREBON"
        },
        "status": {
            "id": 4,
            "flag": "ORDER_PROGRESS",
            "status": "ON PROGRESS",
            "bg_color": "#fd7e14"
        }
    }
}

### Get Production Order by ID
GET {{baseUrl}}/elasticsearch/production-orders/107

### List All Production Orders
GET {{baseUrl}}/elasticsearch/production-orders?size=100

### Update Production Order
PUT {{baseUrl}}/elasticsearch/production-orders/90
Content-Type: application/json

{
    "data": {
        "qty": 150,
        "updated_at": "2025-10-31T10:00:00.000000Z"
    }
}

### Delete Production Order
DELETE {{baseUrl}}/elasticsearch/production-orders/90

### ========================================
### TRACEABILITIES
### ========================================

