            "station": "JIG Report"
        },
        "status": {
            "id": 1,
            "flag": "WH_OK",
            "status": "OK"
        }
    }
}

### Get Traceability by model_identity_number
GET {{baseUrl}}/elasticsearch/traceabilities/PR;2251101001-0011

### List All Traceabilities
GET {{baseUrl}}/elasticsearch/traceabilities?size=100

### ========================================
### NAMEPLATES
### ========================================

### Create Nameplate
POST {{baseUrl}}/elasticsearch/nameplates
Content-Type: application/json

{
    "data": {
        "id": 607,
        "flag": "WH",
        "production_order_id": 91,
        "identity_number": "PR;2251031001-0001",
        "shift_id": 2,
        "user_id": 9,
        "product_work_center_id": 6,
        "station_id": 10,
        "created_at": "2025-10-31T01:33:40.000000Z",
        "updated_at": "2025-10-31T01:33:40.000000Z"
    }
}

### Get Nameplate by identity_number
GET {{baseUrl}}/elasticsearch/nameplates/PR;2251031001-0002

### List All Nameplates
GET {{baseUrl}}/elasticsearch/nameplates?size=10

### ========================================
### SEARCH OPERATIONS
### ========================================

### Generic Search
POST {{baseUrl}}/elasticsearch/search
Content-Type: application/json

{
    "query": "AJI",
    "index": "production_orders_v1",
    "size": 10
}

### Search by Identity Number
GET {{baseUrl}}/elasticsearch/search/production-orders/by-identity/2251101001

### Search by Customer ID
GET {{baseUrl}}/elasticsearch/search/production-orders/by-customer/65

### Search by Station ID (Nested Query)
GET {{baseUrl}}/elasticsearch/search/production-orders/by-station/12

### Search by Shift ID
GET {{baseUrl}}/elasticsearch/search/production-orders/by-shift/2

### List active Production Orders [user_id is optional]
POST {{baseUrl}}/elasticsearch/production-orders/active
Content-Type: application/json

{
    "shift_id": 2,
    "user_id": 9,
    "station_flag": "WH_WASUREMBO",
    "planning_dates": ["2025-11-03", "2025-11-03"],
    "size": 10
}

### Search in Traceabilities Index
POST {{baseUrl}}/elasticsearch/search
Content-Type: application/json

{
    "query": "WH_JIG_REPORT",
    "index": "traceabilities_v1",
    "size": 10
}

# {
#     "query": "traceabilities_v1",
#     "production_order_id": 104,
#     "production_order_flag": "WH",
#     "size": 50
# }

### Search in Nameplates Index
POST {{baseUrl}}/elasticsearch/search
Content-Type: application/json

{
    "query": "PR;2251031001-0001",
    "index": "nameplates_v1",
    "size": 10
}
